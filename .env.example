# Contact form (app/api/contact/route.ts). Server-only: never prefix with NEXT_PUBLIC_.
# Create the key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Where enquiries are delivered (your inbox).
CONTACT_TO_EMAIL=you@example.com

# The "from" address. Must be on a domain verified in Resend, e.g. "Website <hello@itsumair.com>".
# While testing you can use "Website <onboarding@resend.dev>"; Resend only delivers that to your own account email.
CONTACT_FROM_EMAIL=Website <onboarding@resend.dev>
